  "scenarios": [
    {
      "id": "F01",
      "title": "Restart keeps active occurrence and ordered reservations",
      "requirements": [
        "R02",
        "R03",
        "R09"
      ],
      "given": {
        "track": "series_a",
        "completed_through": 9,
        "active": {
          "occurrence": "a10",
          "episode": 10,
          "source_offset_seconds": 600
        },
        "reserved": [
          11,
          12,
          13
        ]
      },
      "events": [
        "restart_scheduler",
        "reconcile_library",
        "reconnect_viewer"
      ],
      "expected": {
        "same_active_occurrence": "a10",
        "do_not_restart_source_at": 0,
        "next_episode": 11,
        "completed_through_before_more_airing": 9,
        "viewer_joins": "current_channel_position"
      }
    },
    {
      "id": "F02",
