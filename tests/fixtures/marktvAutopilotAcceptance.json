      "requirements": [
        "R01",
        "R02"
      ],
      "given": {
        "series_a_completed": 10,
        "series_a_next": 11,
        "series_a_available_episodes": [
          1,
          2,
          10,
          12,
          13
        ],
        "series_b_next": 5,
        "series_b_episode_5_ready": true
      },
      "events": [
        "select_program"
      ],
      "expected": {
        "select": "series_b_episode_5",
        "series_a_state": "blocked_missing_episode_11",
        "must_not_select": [
          "series_a_episode_1",
          "series_a_episode_10",
          "series_a_episode_12"
        ]
      }
    },
