{
  "name": "marktv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/src/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:browser": "playwright test",
    "verify:restart": "node scripts/verify-production-restart.mjs",
    "verify:playback": "node scripts/verify-playback.mjs",
    "continuity:preview": "tsx scripts/prepare-continuity-preview.ts",
    "continuity:validate-assets": "tsx scripts/validate-continuity-assets.ts",
    "continuity:prepare-cards": "tsx scripts/prepare-continuity-assets.ts",
    "continuity:verify-day": "tsx scripts/verify-continuity-live-day.ts",
    "continuity:prepare-general-cards": "tsx scripts/prepare-general-bumper-cards.ts",
    "continuity:render-general-cards": "tsx scripts/render-general-bumper-cards.ts",
    "continuity:register-general-cards": "tsx scripts/register-general-bumper-cards.ts",
    "continuity:activate-general-cards": "tsx scripts/activate-general-station-cards.ts",
    "continuity:deactivate-general-cards": "tsx scripts/deactivate-general-station-cards.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "hls.js": "^1.7.3",
    "luxon": "^3.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^5.0.1"
  }
}
